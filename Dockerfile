# 1. Базовый образ: Linux + Python 3.11 (та же версия, что у нас локально).
#    slim — облегчённый вариант без лишних системных пакетов.
FROM python:3.11-slim

# 2. Рабочая папка внутри контейнера.
WORKDIR /app

# 3. Сначала копируем только список зависимостей и ставим их.
#    Docker кэширует каждый шаг: если поменяется только код, этот слой
#    возьмётся из кэша, и библиотеки не будут скачиваться заново.
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# 4. Копируем то, что нужно сервису: код, модель и таблицу признаков.
COPY main.py model.joblib ./
COPY data/processed/state_features.csv data/processed/

# 5. Порт, на котором слушает сервис.
EXPOSE 8000

# 6. Запуск. --host 0.0.0.0 — принимать запросы снаружи контейнера
#    (с 127.0.0.1 сервис был бы доступен только внутри самого контейнера).
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
